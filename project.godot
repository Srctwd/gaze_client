; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="gaze_client"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://b72y81ppltcvw"
config/icon="res://icon.svg"
config/run/main_scene="res://main.tscn"

[audio]

driver/enable_input=true

[autoload]

Config="*res://config.gd"
GameState="*res://game_state.gd"
Network="*res://net/network.gd"
Protocol="*res://net/protocol.gd"
Ps2="*res://ps2/ps2.gd"
Sfx="*res://game/sfx.gd"

[display]

window/size/mode=3

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

