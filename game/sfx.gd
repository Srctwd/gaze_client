extends Node

# Sound effects (autoload "Sfx"). The sounds are generated by
# sounds/make_sounds.py and played at world positions as AudioStreamPlayer3D
# from a small pool, heard from the current camera:
#   - combat, from network events: swings and shots (ActionOk / FreeAimShot),
#     hits (UnitHit — the attacker's weapon or projectile picks the sound via
#     its prefab's `hit_sound`), deaths (DestroyUnit right after a hit or a kill)
#   - movement, from every unit's UnitPos stream: footsteps on stone or grass,
#     jump, land, splash into / strokes through water, climbing
# Volumes: Master plus the "SFX" and "Ambience" buses, saved in user://audio.cfg.

const SOUND_DIR := "res://sounds/"
const SETTINGS_PATH := "user://audio.cfg"
const BUSES := ["Master", "SFX", "Ambience"]

const POOL_SIZE   := 32
const HEAR_RANGE  := 30.0   # max_distance of every player; units beyond it make no movement sounds
const STEP_EVERY  := 0.38   # seconds between a walking player's footsteps
const CLIMB_EVERY := 0.42
const STROKE_EVERY := 0.85
const STALE_POS   := 0.3    # no UnitPos for this long = standing still
const BASE_DB     := -10.0  # every sound's baseline loudness, before TRIM and the volume sliders
const DEATH_AFTER_HIT := 1.5  # a unit removed this soon after a hit died (vs. walked out of view)

# name -> number of variants ("step_stone" -> step_stone_1..3), 0 = a single file.
const SOUNDS := {
	"swing": 0, "throw": 0, "bow": 0, "magic_cast": 0, "flame": 0, "fireball_cast": 0,
	"hit_default": 0, "hit_blunt": 0, "hit_slash": 0, "hit_pierce": 0, "hit_rock": 0,
	"hit_fire": 0, "hit_magic": 0, "block_armor": 0, "block_defend": 0,
	"monster_death": 0, "player_hurt": 0,
	"jump": 0, "land": 0, "splash": 0, "swim": 0, "climb": 2,
	"step_stone": 3, "step_grass": 3,
}

# Per-sound loudness trim (dB), for the ones that come out hot or thin.
const TRIM := { "magic_cast": -4.0, "step_stone": -11.0, "step_grass": -9.0,
	"swim": -4.0, "climb": -8.0, "jump": -6.0, "land": -3.0 }

# Footstep pitch/volume by body size: rats patter, big monsters stomp.
const _SMALL_UNITS := [Protocol.UNIT_RAT, Protocol.UNIT_CAVE_RAT, Protocol.UNIT_SNAKE, Protocol.UNIT_SLIME]
const _BIG_UNITS   := [Protocol.UNIT_MINOTAUR, Protocol.UNIT_DEMON]
const _SILENT_UNITS := [Protocol.UNIT_CHEST]
const _NOT_MONSTERS := [Protocol.UNIT_PLAYER, Protocol.UNIT_NPC, Protocol.UNIT_CHEST]

var terrain: Node = null  # world/terrain.gd, set by main.gd — footstep surfaces

var _streams := {}   # file name -> AudioStream
var _pool: Array[AudioStreamPlayer3D] = []
var _next := 0

# net_id -> {type, pos, radius, anim, moving, climbing, seen, step, climb, stroke, hit_at, killed}
var _units := {}
var _mainhand := {}     # net_id -> item def id held
var _last_attack := {}  # net_id -> "melee" | "ranged" | "fire" — what its next UnitHit came from
var _attack_sound_at := {}  # net_id -> msec of its last swing/shot sound (ActionOk repeats per target)
var _item_hit_cache := {}   # item name -> hit_sound of its prefab
var _proj_hit_cache := {}   # item name -> hit_sound of its projectile prefab


func _ready() -> void:
	for bus in BUSES:
		if AudioServer.get_bus_index(bus) < 0:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	_load_volumes()

	for name: String in SOUNDS:
		var n: int = SOUNDS[name]
		for v in (range(1, n + 1) if n > 0 else [0]):
			var file := name if v == 0 else "%s_%d" % [name, v]
			var stream := load(SOUND_DIR + file + ".wav") as AudioStream
			if stream == null:
				push_error("Sfx: missing " + SOUND_DIR + file + ".wav")
			else:
				_streams[file] = stream

	for i in POOL_SIZE:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.max_distance = HEAR_RANGE
		p.unit_size = 3.0
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p)
		_pool.append(p)

	Network.unit_spawned.connect(_on_unit_spawned)
	Network.unit_pos.connect(_on_unit_pos)
	Network.unit_destroyed.connect(_on_unit_destroyed)
	Network.equip_synced.connect(_on_equip_synced)
	Network.action_ok.connect(_on_action_ok)
	Network.free_aim_shot.connect(_on_free_aim_shot)
	Network.unit_hit.connect(_on_unit_hit)
	Network.xp_gained.connect(_on_xp_gained)
	Network.login_ok.connect(func(_id: int) -> void: _units.clear(); _mainhand.clear(); _last_attack.clear())


# Plays `name` (a SOUNDS key; variants are picked at random) at `pos`, with a
# small random pitch spread so repeats don't sound identical.
func play_at(name: String, pos: Vector3, volume_db := 0.0, pitch := 1.0, spread := 0.08) -> void:
	var n: int = SOUNDS.get(name, 0)
	var file := name if n == 0 else "%s_%d" % [name, randi_range(1, n)]
	var stream := _streams.get(file) as AudioStream
	if stream == null:
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stop()
	p.stream = stream
	p.global_position = pos
	p.volume_db = BASE_DB + volume_db + float(TRIM.get(name, 0.0))
	p.pitch_scale = pitch * randf_range(1.0 - spread, 1.0 + spread)
	p.play()


# ── volumes ──────────────────────────────────────────────────────────────────

# 0..1 linear; 0 mutes the bus.
func get_volume(bus: String) -> float:
	var i := AudioServer.get_bus_index(bus)
	if i < 0 or AudioServer.is_bus_mute(i):
		return 0.0
	return db_to_linear(AudioServer.get_bus_volume_db(i))

func set_volume(bus: String, value: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i < 0:
		return
	value = clampf(value, 0.0, 1.0)
	AudioServer.set_bus_mute(i, value <= 0.001)
	AudioServer.set_bus_volume_db(i, linear_to_db(maxf(value, 0.001)))
	_save_volumes()

func _load_volumes() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) != OK:
		return
	for bus in BUSES:
		var i := AudioServer.get_bus_index(bus)
		var value := float(cfg.get_value("volume", bus, 1.0))
		AudioServer.set_bus_mute(i, value <= 0.001)
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(value, 0.001)))

func _save_volumes() -> void:
	var cfg := ConfigFile.new()
	for bus in BUSES:
		cfg.set_value("volume", bus, get_volume(bus))
	cfg.save(SETTINGS_PATH)


# ── combat ───────────────────────────────────────────────────────────────────

func _on_equip_synced(net_id: int, slot: int, item_def_id: int, _quantity: int) -> void:
	if slot == Protocol.SLOT_MAINHAND:
		_mainhand[net_id] = item_def_id

func _mainhand_name(net_id: int) -> String:
	return Protocol.item_name_by_id.get(_mainhand.get(net_id, 0), "")

# ActionOk arrives once per target hit — one swing/shot sound per attack.
func _first_attack_sound(actor_id: int) -> bool:
	var now := Time.get_ticks_msec()
	if now - int(_attack_sound_at.get(actor_id, -1000)) < 100:
		return false
	_attack_sound_at[actor_id] = now
	return true

func _on_action_ok(actor_id: int, effect: int, target_id: int, action_type: int) -> void:
	var actor_pos := _unit_pos(actor_id)
	if action_type == Protocol.ACTION_SPELL:
		_last_attack[actor_id] = "fire" if effect == Protocol.EFFECT_FLAME or effect == Protocol.EFFECT_FIREBALL else "ranged"
		if not _first_attack_sound(actor_id):
			return
		if effect == Protocol.EFFECT_FLAME:
			play_at("flame", _unit_pos(target_id) if _units.has(target_id) else actor_pos)
		elif effect == Protocol.EFFECT_FIREBALL:
			play_at("fireball_cast", actor_pos)
		else:
			play_at("magic_cast", actor_pos)
	elif effect == Protocol.EFFECT_PROJECTILE:
		_last_attack[actor_id] = "ranged"
		if _first_attack_sound(actor_id):
			play_at(_launch_sound(actor_id), actor_pos)
	elif effect == Protocol.EFFECT_SWING:
		_last_attack[actor_id] = "melee"
		if _first_attack_sound(actor_id):
			play_at("swing", actor_pos, 0.0, _body_pitch(actor_id))

func _on_free_aim_shot(actor_id: int, origin: Vector3, _yaw: float, _pitch: float, _speed: float, _range: float, effect: int) -> void:
	if effect == Protocol.EFFECT_FIREBALL:
		_last_attack[actor_id] = "fire"
		play_at("fireball_cast", origin)
	else:
		_last_attack[actor_id] = "ranged"
		play_at(_launch_sound(actor_id), origin)

# What firing the held item sounds like: thrown stacks (daggers, stones)
# whoosh, two-handed launchers (the bow) twang, anything else casts.
func _launch_sound(actor_id: int) -> String:
	var def := Protocol.item_defs.get(_mainhand.get(actor_id, 0), {}) as Dictionary
	if int(def.get("max_stack", 1)) > 1:
		return "throw"
	if def.get("two_handed", false):
		return "bow"
	return "magic_cast"

func _on_unit_hit(target_id: int, attacker_id: int, count: int, absorbed: int, armored: int, defended: int) -> void:
	var pos := _unit_pos(target_id)
	if _units.has(target_id):
		_units[target_id].hit_at = Time.get_ticks_msec()
	if count - absorbed > 0:
		play_at("hit_" + _hit_sound(attacker_id), pos)
		if target_id == GameState.player_net_id:
			play_at("player_hurt", pos)
	if armored > 0:
		play_at("block_armor", pos)
	if defended > 0:
		play_at("block_defend", pos)

# The hit sound for attacker_id's latest attack: fire for fire spells; for a
# ranged shot its projectile's hit_sound unless that's "default"; otherwise
# the held item's own; "default" with nothing in hand (claws, fists).
func _hit_sound(attacker_id: int) -> String:
	var kind: String = _last_attack.get(attacker_id, "melee")
	if kind == "fire":
		return "fire"
	var item := _mainhand_name(attacker_id)
	if item.is_empty():
		return "default"
	if kind == "ranged":
		var proj := _projectile_hit_sound(item)
		if proj != "default":
			return proj
	return _item_hit_sound(item)

func _item_hit_sound(item: String) -> String:
	if not _item_hit_cache.has(item):
		_item_hit_cache[item] = _scene_hit_sound(Protocol.get_item_prefab(item))
	return _item_hit_cache[item]

func _projectile_hit_sound(item: String) -> String:
	if not _proj_hit_cache.has(item):
		_proj_hit_cache[item] = _scene_hit_sound(Protocol.get_item_projectile_scene(item))
	return _proj_hit_cache[item]

func _scene_hit_sound(scene: PackedScene) -> String:
	if scene == null:
		return "default"
	var inst := scene.instantiate()
	var sound = inst.get("hit_sound")
	inst.free()
	return sound if sound is String and SOUNDS.has("hit_" + sound) else "default"

func _on_xp_gained(monster_net_id: int, _player_ids: Array) -> void:
	if _units.has(monster_net_id):
		_units[monster_net_id].killed = true

func _on_unit_destroyed(net_id: int) -> void:
	var u: Variant = _units.get(net_id)
	_units.erase(net_id)
	_mainhand.erase(net_id)
	_last_attack.erase(net_id)
	if u == null or u.type in _NOT_MONSTERS:
		return
	if u.killed or Time.get_ticks_msec() - int(u.hit_at) < DEATH_AFTER_HIT * 1000.0:
		play_at("monster_death", u.pos, 0.0, _body_pitch(net_id, u))


# ── movement ─────────────────────────────────────────────────────────────────

func _on_unit_spawned(net_id: int, unit_type: int, _variant: int, pos: Vector3, anim_state: int, radius: float, _height: float) -> void:
	_units[net_id] = _new_unit(unit_type, pos, anim_state, radius)

func _new_unit(unit_type: int, pos: Vector3, anim_state: int, radius: float) -> Dictionary:
	return { type = unit_type, pos = pos, radius = radius if radius > 0.0 else 0.4, anim = anim_state,
		moving = false, climbing = false, seen = Time.get_ticks_msec(),
		step = 0.0, climb = 0.0, stroke = 0.0, hit_at = -100000, killed = false }

func _on_unit_pos(net_id: int, unit_type: int, _variant: int, pos: Vector3, _rot_y: float, _pitch: float, anim_state: int) -> void:
	if unit_type in _SILENT_UNITS:
		return
	if not _units.has(net_id):
		_units[net_id] = _new_unit(unit_type, pos, anim_state, 0.4)
		return
	var u: Dictionary = _units[net_id]
	var delta: Vector3 = pos - (u.pos as Vector3)
	var horizontal := Vector2(delta.x, delta.z).length()
	var prev: int = u.anim
	u.moving = horizontal > 0.05
	# Climbing is sent as Ground: rising or sinking in place.
	u.climbing = anim_state == Protocol.ANIM_GROUND and absf(delta.y) > 0.05 and horizontal < 0.05
	u.pos = pos
	u.anim = anim_state
	u.seen = Time.get_ticks_msec()

	if not _audible(pos):
		return
	var feet := _feet(u)
	if prev == Protocol.ANIM_GROUND and anim_state == Protocol.ANIM_JUMP:
		play_at("jump", feet, 0.0, _body_pitch(net_id, u))
	elif (prev == Protocol.ANIM_JUMP or prev == Protocol.ANIM_FALL) and anim_state == Protocol.ANIM_GROUND:
		play_at("land", feet, _body_db(u), _body_pitch(net_id, u))
		u.step = STEP_EVERY * 0.5
	elif prev != Protocol.ANIM_SWIM and anim_state == Protocol.ANIM_SWIM:
		play_at("splash", feet, _body_db(u), _body_pitch(net_id, u))
		u.stroke = STROKE_EVERY

func _process(delta: float) -> void:
	var now := Time.get_ticks_msec()
	for net_id: int in _units:
		var u: Dictionary = _units[net_id]
		if now - int(u.seen) > STALE_POS * 1000.0:
			u.moving = false
			u.climbing = false
		if not _audible(u.pos):
			continue
		if u.climbing:
			u.climb = float(u.climb) - delta
			if u.climb <= 0.0:
				play_at("climb", u.pos, _body_db(u), _body_pitch(net_id, u))
				u.climb = CLIMB_EVERY
		elif u.anim == Protocol.ANIM_SWIM and u.moving:
			u.stroke = float(u.stroke) - delta
			if u.stroke <= 0.0:
				play_at("swim", _feet(u), _body_db(u))
				u.stroke = STROKE_EVERY
		elif u.anim == Protocol.ANIM_GROUND and u.moving:
			u.step = float(u.step) - delta
			if u.step <= 0.0:
				var feet := _feet(u)
				var surface: String = terrain.footstep_surface(feet) if terrain != null else "stone"
				play_at("step_" + surface, feet, _body_db(u), _body_pitch(net_id, u))
				u.step = STEP_EVERY * (0.55 if u.type in _SMALL_UNITS else 1.0)
		else:
			u.step = minf(float(u.step), STEP_EVERY * 0.3)   # first step comes quickly


# ── helpers ──────────────────────────────────────────────────────────────────

func _unit_pos(net_id: int) -> Vector3:
	return (_units[net_id] as Dictionary).pos if _units.has(net_id) else Vector3.ZERO

func _feet(u: Dictionary) -> Vector3:
	return (u.pos as Vector3) - Vector3(0, float(u.radius), 0)

func _audible(pos: Vector3) -> bool:
	var cam := get_viewport().get_camera_3d()
	return cam != null and cam.global_position.distance_to(pos) < HEAR_RANGE

func _body_pitch(net_id: int, u: Variant = null) -> float:
	var unit := (u if u != null else _units.get(net_id, {})) as Dictionary
	var t: int = unit.get("type", Protocol.UNIT_PLAYER)
	if t in _SMALL_UNITS: return 1.5
	if t in _BIG_UNITS: return 0.7
	return 1.0

func _body_db(u: Dictionary) -> float:
	if u.type in _SMALL_UNITS: return -6.0
	if u.type in _BIG_UNITS: return 3.0
	return 0.0
